# Ejemplo nube, SOLO placeholders; usar entorno QA con cuentas NO productivas.
EF_DATABASE__PROVIDER=MySql
EF_DATABASE__HOST=mysql-qa.example.com
EF_DATABASE__PORT=3306
EF_DATABASE__NAME=EF_QA
EF_DATABASE__USERNAME=ef_qa
EF_DATABASE__PASSWORD=REEMPLAZAR
# Remoto: VerifyFull obligatorio para validar CA y nombre de host.
EF_DATABASE__SSL_MODE=VerifyFull
EF_DATABASE__SSL_CA=/ruta/al/certificado/ca.pem
