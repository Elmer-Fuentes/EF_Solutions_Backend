# Referencia para variables protegidas del servicio, no se carga como archivo en producción.
DOTNET_ENVIRONMENT=Production
EF_DATABASE__PROVIDER=MySql
EF_DATABASE__HOST=
EF_DATABASE__PORT=3306
EF_DATABASE__NAME=
EF_DATABASE__USERNAME=
EF_DATABASE__PASSWORD=
# Remoto: VerifyFull obligatorio para validar CA y nombre de host.
EF_DATABASE__SSL_MODE=VerifyFull
EF_DATABASE__SSL_CA=
